{
  "db_name": "PostgreSQL",
  "query": "\n        WITH \n            removed_mods AS (DELETE FROM game_mods WHERE game_id=$38 AND mod_id <> ALL($39)),\n            updated_mods AS (INSERT INTO game_mods (game_id, mod_id) VALUES($38, UNNEST($39::integer[])) ON CONFLICT (game_id, mod_id) DO NOTHING)\n        UPDATE games SET \n            era                    = $1,\n            thrones_t1             = $2,\n            thrones_t2             = $3,\n            thrones_t3             = $4,\n            throne_points_required = $5,\n            research_diff          = $6,\n            research_rand          = $7,\n            hof_size               = $8,\n            global_size            = $9,\n            indepstr               = $10,\n            magicsites             = $11,\n            eventrarity            = $12,\n            richness               = $13,\n            resources              = $14,\n            recruitment            = $15,\n            supplies               = $16,\n            startprov              = $17,\n            renaming               = $18,\n            scoregraphs            = $19,\n            nationinfo             = $20,\n            artrest                = $21,\n            teamgame               = $22,\n            clustered              = $23,\n            storyevents            = $24,\n            newailvl               = $25,\n            maps_dom6_id           = $26,\n            masterpass             = $27,\n            private                = $28,\n            require_password       = $29,\n            select_start           = $30,\n            cataclysm              = $31,\n            max_stales             = $32,\n            conq_all               = $33,\n            formal_diplo           = $34,\n            research_9_slow        = $35,\n            cheat_detection        = $36,\n            mercslots              = $37\n        WHERE\n            id                     = $38\n        RETURNING *\n        ",
