  "query": "\n    SELECT j.turn_number, j.started_at, sj.label as \"label?\"\n    FROM jobs j \n    LEFT JOIN subjobs sj ON sj.job_id=j.job_id AND sj.finished_at IS NULL\n    WHERE j.game_id=$1 AND j.finished_at IS NULL AND reaped!=TRUE",
