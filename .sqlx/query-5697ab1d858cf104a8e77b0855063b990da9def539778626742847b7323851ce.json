  "query": "SELECT * \n                    FROM maps m \n                    WHERE \n                        m.name ILIKE $1 OR \n                        EXISTS (SELECT g.* FROM games g WHERE g.id=$2 AND g.map_id=m.id)\n                    ORDER BY (SELECT COUNT(*) FROM games g WHERE g.map_id=m.id) DESC",
