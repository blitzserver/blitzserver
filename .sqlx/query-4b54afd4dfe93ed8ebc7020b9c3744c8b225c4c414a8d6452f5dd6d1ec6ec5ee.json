  "query": "\n        SELECT M.* \n        FROM maps M\n        LEFT JOIN games G \n            ON M.id=G.map_id AND G.id = $1\n        WHERE (G.id IS NOT NULL OR M.archived IS FALSE)\n            AND (G.id IS NOT NULL OR $2 = TRUE)",
