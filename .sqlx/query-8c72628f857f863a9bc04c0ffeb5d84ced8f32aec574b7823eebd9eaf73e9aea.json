{
  "db_name": "PostgreSQL",
  "query": "\n        WITH \n            removed_mods AS (DELETE FROM game_mods WHERE game_id=$1 AND mod_id <> ALL($2)),\n            updated_mods AS (INSERT INTO game_mods (game_id, mod_id) VALUES($1, UNNEST($2::integer[])) ON CONFLICT (game_id, mod_id) DO NOTHING)\n        UPDATE games SET \n            era                    = $3,\n            thrones_t1             = $4,\n            thrones_t2             = $5,\n            thrones_t3             = $6,\n            throne_points_required = $7,\n            research_diff          = $8,\n            research_rand          = $9,\n            hof_size               = $10,\n            global_size            = $11,\n            indepstr               = $12,\n            magicsites             = $13,\n            eventrarity            = $14,\n            richness               = $15,\n            resources              = $16,\n            recruitment            = $17,\n            supplies               = $18,\n            startprov              = $19,\n            renaming               = $20,\n            scoregraphs            = $21,\n            nationinfo             = $22,\n            artrest                = $23,\n            teamgame               = $24,\n            clustered              = $25,\n            storyevents            = $26,\n            newailvl               = $27,\n            maps_dom6_id           = $28,\n            masterpass             = $29,\n            private                = $30,\n            require_password       = $31,\n            select_start           = $32,\n            cataclysm              = $33,\n            max_stales             = $34,\n            conq_all               = $35,\n            formal_diplo           = $36,\n            research_9_slow        = $37,\n            cheat_detection        = $38,\n            mercslots              = $39,\n            provs_per_player       = $40,\n            randommap_wrapping     = $41,\n            log_level = $42\n        WHERE\n            id                     = $1\n        RETURNING *\n        ",
